{
  "name": "@tieout/sdk",
  "version": "0.1.0",
  "description": "Structured payment memos, batch payouts, references and log readers for Circle's Arc",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ZhenYan1214/ARC.git",
    "directory": "packages/sdk"
  },
  "keywords": [
    "arc",
    "circle",
    "usdc",
    "reconciliation",
    "iso20022",
    "memo",
    "accounting"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "viem": "^2.21.0"
  }
}
