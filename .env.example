# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored. Never commit a private key.

# Wallet used by the CLI scripts (spike, demo payouts).
# Use a dedicated wallet that only holds a small amount of USDC.
TESTNET_PRIVATE_KEY=
MAINNET_PRIVATE_KEY=

# Optional: override RPC endpoints.
# ARC_TESTNET_RPC=https://rpc.testnet.arc.io
# ARC_MAINNET_RPC=https://rpc.mainnet.arc.io
